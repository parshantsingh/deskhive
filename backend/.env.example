SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://deskhive:deskhive@localhost:5432/deskhive
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# Attachment storage (S3-compatible). Defaults point at the local LocalStack
# container; in production set these to a real bucket/region and remove
# AWS_S3_ENDPOINT_URL entirely so boto3 talks to real AWS.
AWS_STORAGE_BUCKET_NAME=deskhive-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
